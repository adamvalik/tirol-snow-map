{
  "name": "tirol-snow-map",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "pipeline": "tsx pipeline/src/run.ts",
    "pipeline:fixtures": "tsx pipeline/src/run.ts --fixtures",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "basemap": "tsx pipeline/src/basemap/run.ts",
    "basemap:assets": "tsx pipeline/src/basemap/assets.ts",
    "dem": "tsx pipeline/src/dem-run.ts",
    "bivouacs": "tsx pipeline/src/bivouacs-run.ts",
    "ferratas": "tsx pipeline/src/ferratas-run.ts"
  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "maplibre-gl": "6.12.0",
    "pmtiles": "4.5.0"
  },
  "devDependencies": {
    "@types/geojson": "7946.0.16",
    "@types/node": "26.6.5",
    "fflate": "0.8.3",
    "geotiff": "3.0.5",
    "playwright": "1.56.1",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
